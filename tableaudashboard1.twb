            <column caption='Staff with more than 20days leave' datatype='integer' name='[Calculation_0835679570501633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[Leave Balance]&gt;20 THEN 1 ELSE 0 END' />
